PLAYWRIGHT_BASE_URL=http://127.0.0.1:8080

# Values in angle brackets are placeholders. VN and VND are examples for a matching sale fixture.
# Business flows. Set E2E_BUSINESS=1 only against an isolated staging environment.
E2E_BUSINESS=0
E2E_API_URL=http://localhost:8081


# Flow 04: wildcard DNS/FE, outbound Keycloak SMTP, internal onboarding token
# Local Vite profile. Start Vite on 5173 and use APP_TENANT_REDIRECT_SCHEME=http on the test backend.
E2E_TENANT_BASE_URL=http://localhost:5173
# Current FE setting; confirm the IdP is suitable for creating disposable realms before enabling writes.
E2E_KEYCLOAK_URL=
# TempMail.Plus receives the staging verification email.
E2E_TEMPMAIL_URL=https://tempmail.plus
E2E_MAIL_DOMAIN=fexpost.com
E2E_ONBOARD_TOKEN=<onboarding-internal-access-token>


# Flow 05: internal tokens; eligible brand/partner of this enterprise; partner country code
E2E_ENTERPRISE_TOKEN=<enterprise-internal-access-token>
E2E_PRODUCT_APPROVER_TOKEN=<product-approver-internal-access-token>
E2E_BRAND_ID=<eligible-brand-tenant-id>
E2E_PARTNER_ID=<eligible-distribution-partner-id>
E2E_REGION=VN


# Flow 06: real sandbox POST URL, optional JSON authentication headers, valid JSON request file
# Include {{invoiceNumber}} and optionally {{transactionTime}} in string fields of that file.
E2E_HASHCORE_SUBMIT_URL=<sandbox-transaction-submit-url>
E2E_HASHCORE_HEADERS_JSON={}
# Path to a real, locally stored sandbox request body, relative to EcoFood-Auto or absolute.
E2E_HASHCORE_PAYLOAD_FILE=<path-to-sandbox-request.json>
# Use a dedicated reporting scope with no concurrent sales. Enable asynchronous KPI processing.
E2E_TRANSACTION_READ_TOKEN=<pos-tenant-transaction-reader-token>
E2E_DASHBOARD_TOKEN=<dashboard-reader-internal-token>
E2E_SALE_TENANT_ID=<transaction-tenant-id>
E2E_SALE_PROPOSITION_ID=<active-sale-proposition-id>
E2E_SALE_CURRENCY=VND
